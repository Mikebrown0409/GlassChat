# GlassChat Environment Variables
# Copy this file to .env and fill in your actual values

# Database
# For production use a real database connection string (e.g. Supabase Postgres). For local dev you can still use SQLite.
DATABASE_URL="postgres://postgres:YOURPASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) for Prisma migrations — replace with your Supabase host
DATABASE_DIRECT_URL="postgres://postgres:YOURPASSWORD@db.YOURPROJECT.supabase.co:5432/postgres"

# NextAuth.js Configuration
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Authentication Providers (Optional)
# Get these from Discord Developer Portal: https://discord.com/developers/applications
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# AI API Keys
# OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Google Generative AI API key from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-google-api-key-here"

# Upstash Redis (Optional - will use local mock if not provided)
# For production, get these from: https://console.upstash.com/
# For development, you can also use local Redis (redis-server on localhost:6379)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token-here"

# Pusher Configuration (Real-time collaboration)
# Get these from: https://dashboard.pusher.com/
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="us2"

# Pusher public key for client-side (exposed to browser)
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# Development Settings
NODE_ENV="development"

# Collaboration Features
# Enable WebSocket for real-time collaboration
NEXT_PUBLIC_ENABLE_WS="true"

# Optional: Skip environment validation during build
# SKIP_ENV_VALIDATION="true" 